# Sample environment configuration for Caddy setup
# Copy this file to .env and update the values

# Deployment directories (DO NOT EDIT)
DEPLOYMENTS_MOUNT_DIR='/path/to/sarthi/deployments'
CADDY_PROXY_CONF_LOCATION='/path/to/sarthi/caddy-confs'

# Environment
ENV='local'  # Options: local, prod

# Domain configuration
DOMAIN_NAME='sarthi.yourcompany.io'  # Your wildcard domain

# Caddy-specific configuration
CADDY_EMAIL='admin@yourcompany.io'  # Email for Let's Encrypt notifications

# Proxy type selection
PROXY_TYPE='caddy'  # Options: nginx, caddy

# Secret for GitHub Actions authentication
SECRET_TEXT='your-secret-token-here'

# Vault configuration
VAULT_TOKEN='your-vault-token'
VAULT_BASE_URL='http://vault:8200'

# Port range for deployments
DEPLOYMENT_PORT_START=15000
DEPLOYMENT_PORT_END=25000

# Optional: For wildcard SSL with DNS challenge (Cloudflare example)
# CLOUDFLARE_API_TOKEN='your-cloudflare-api-token'
